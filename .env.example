# =============================================================
# Kit do Pet — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# Variáveis NEXT_PUBLIC_* vão para o navegador; as demais ficam só no servidor.
# =============================================================

# --- Site ---
# Endereço público do app (sem barra no final). Usado nos QR codes e links de acesso.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo aleatório longo (assina links de acesso). Gere com: openssl rand -hex 32
APP_SECRET=
# E-mail(s) com acesso ao painel /admin, separados por vírgula.
ADMIN_EMAILS=

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-mail) ---
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Kit do Pet <ola@seudominio.com.br>
EMAIL_FROM=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- Kiwify ---
# Token do webhook (Kiwify → Apps → Webhooks)
KIWIFY_WEBHOOK_TOKEN=
# IDs dos produtos na Kiwify (aceita mais de um, separados por vírgula)
KIWIFY_PRODUCT_KIT=
KIWIFY_PRODUCT_REMINDERS=
KIWIFY_PRODUCT_EXTRA_PET=
KIWIFY_PRODUCT_GUIDE_TRAINING=
KIWIFY_PRODUCT_GUIDE_TREATS=

# --- Cakto (opcional, para quando trocar de plataforma) ---
CAKTO_WEBHOOK_SECRET=
CAKTO_PRODUCT_KIT=
CAKTO_PRODUCT_REMINDERS=
CAKTO_PRODUCT_EXTRA_PET=
CAKTO_PRODUCT_GUIDE_TRAINING=
CAKTO_PRODUCT_GUIDE_TREATS=

# --- Links de checkout ---
# Checkout principal (botão de compra das páginas de vendas)
NEXT_PUBLIC_CHECKOUT_URL=
# Checkout avulso do "Mais um pet" (mostrado quando o limite de pets acaba)
NEXT_PUBLIC_EXTRA_PET_CHECKOUT_URL=
# Checkout de renovação dos lembretes (enviado 30 dias antes de vencer)
RENEWAL_CHECKOUT_URL=

# --- Meta Pixel ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Suporte (opcional): WhatsApp de atendimento exibido nas páginas, só dígitos com DDI ---
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Cron da Vercel ---
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" nas chamadas do cron.
CRON_SECRET=
